{
  "name": "alpha-ondulado",
  "productName": "Alpha Ondulado",
  "version": "0.2.0",
  "description": "Le os grupos do Illustrator no PDF e gera orcamento de cliche por area x fator x arranjo (uso interno Alpha)",
  "author": "Alpha Clicheria",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "fzstd": "^0.1.1",
    "pdfjs-dist": "3.11.174"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.alphaclicheria.alphaondulado",
    "productName": "Alpha Ondulado",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*",
      "node_modules/pdfjs-dist/**/*",
      "node_modules/fzstd/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "AlphaOndulado-Portable-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Alpha Ondulado"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.graphics-design"
    }
  }
}
