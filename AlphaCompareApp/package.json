{
  "name": "alpha-compare-app",
  "productName": "Alpha Compare",
  "version": "0.1.4",
  "description": "Conferencia original x tratado estilo Precision Proof: registro + diff de texto por OCR nativo (RapidOCR) e diff grafico por pixel (uso interno Alpha)",
  "author": "Alpha Clicheria",
  "main": "main.js",
  "alphaUpdate": {
    "nome": "AlphaCompare",
    "pastas": [
      "\\\\aeserver16\\Engine\\versoes",
      "\\\\172.16.11.96\\Engine\\versoes",
      "/Volumes/Engine/versoes"
    ]
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "javascript-obfuscator": "^5.5.0"
  },
  "build": {
    "appId": "com.alphaclicheria.alphacompareapp",
    "productName": "Alpha Compare",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*",
      "lib/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/render/*.py",
      "src/ocr/*.py"
    ],
    "extraResources": [
      {
        "from": "build/ocr_dist/ocr_server",
        "to": "ocr"
      },
      {
        "from": "build/ocr_dist/render_server",
        "to": "render"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Alpha Compare"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.graphics-design",
      "artifactName": "AlphaCompare-mac-${version}.dmg"
    }
  }
}
