<?xml version="1.0" encoding="UTF-8"?>
<!--
  Alpha Compare - comparador visual (estilo "Precision Proof" caseiro).
  Extensao de TESTE, independente do Flexivel/Ondulado (IDs proprios p/ coexistir).
  Host ILST [26.0,99.9] = Illustrator 2022 em diante.
  Precisa de PlayerDebugMode=1 (ver README) por nao estar assinada.
-->
<ExtensionManifest Version="9.0" ExtensionBundleId="com.alpha.compare"
    ExtensionBundleVersion="0.1.0" ExtensionBundleName="Alpha Compare"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.alpha.compare.panel" Version="0.1.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="ILST" Version="[26.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.alpha.compare.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./host/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Alpha Compare</Menu>
          <Geometry>
            <Size><Height>860</Height><Width>920</Width></Size>
            <MinSize><Height>420</Height><Width>420</Width></MinSize>
            <MaxSize><Height>2400</Height><Width>1600</Width></MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./img/icon-n.png</Icon>
            <Icon Type="RollOver">./img/icon-r.png</Icon>
            <Icon Type="DarkNormal">./img/icon-n.png</Icon>
            <Icon Type="DarkRollOver">./img/icon-r.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
