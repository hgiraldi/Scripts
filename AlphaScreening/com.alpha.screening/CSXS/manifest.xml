<?xml version="1.0" encoding="UTF-8"?>
<!--
  AlphaScreening - Ink Manager + screening por tinta (uso interno Alpha).
  Extensao de TESTE, independente do Flexivel/Ondulado/AlphaCompare/AlphaPack.
  Host ILST [26.0,99.9] = Illustrator 2022 em diante.
  Precisa de PlayerDebugMode=1 (rode o instalar.bat) por nao estar assinada.
-->
<ExtensionManifest Version="9.0" ExtensionBundleId="com.alpha.screening"
    ExtensionBundleVersion="1.0.0" ExtensionBundleName="AlphaScreening"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.alpha.screening.panel" Version="1.0.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="ILST" Version="[26.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.alpha.screening.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./host/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>AlphaScreening</Menu>
          <Geometry>
            <Size><Height>720</Height><Width>480</Width></Size>
            <MinSize><Height>420</Height><Width>420</Width></MinSize>
            <MaxSize><Height>2200</Height><Width>1100</Width></MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./img/icon-n.png</Icon>
            <Icon Type="RollOver">./img/icon-r.png</Icon>
            <Icon Type="DarkNormal">./img/icon-n.png</Icon>
            <Icon Type="DarkRollOver">./img/icon-r.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
