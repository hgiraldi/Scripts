<?xml version="1.0" encoding="UTF-8"?>
<!--
  AlphaPack - suite de pre-impressao (estilo Esko DeskPack), uso interno.
  Extensao de TESTE, independente do Flexivel/Ondulado e do AlphaCompare (IDs proprios).
  Host ILST [26.0,99.9] = Illustrator 2022 em diante.
  Precisa de PlayerDebugMode=1 (ver README) por nao estar assinada.
-->
<ExtensionManifest Version="9.0" ExtensionBundleId="com.alpha.pack"
    ExtensionBundleVersion="0.1.0" ExtensionBundleName="AlphaPack"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.alpha.pack.panel" Version="0.1.0"/>
    <Extension Id="com.alpha.pack.screen" Version="0.1.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="ILST" Version="[26.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.alpha.pack.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./host/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>AlphaPack</Menu>
          <Geometry>
            <Size><Height>640</Height><Width>420</Width></Size>
            <MinSize><Height>360</Height><Width>360</Width></MinSize>
            <MaxSize><Height>2000</Height><Width>900</Width></MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./img/icon-n.png</Icon>
            <Icon Type="RollOver">./img/icon-r.png</Icon>
            <Icon Type="DarkNormal">./img/icon-n.png</Icon>
            <Icon Type="DarkRollOver">./img/icon-r.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>

    <Extension Id="com.alpha.pack.screen">
      <DispatchInfo>
        <Resources>
          <MainPath>./screen.html</MainPath>
          <ScriptPath>./host/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Modeless</Type>
          <Menu>AlphaPack Screening</Menu>
          <Geometry>
            <Size><Height>700</Height><Width>560</Width></Size>
            <MinSize><Height>420</Height><Width>460</Width></MinSize>
            <MaxSize><Height>2000</Height><Width>1100</Width></MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./img/icon-n.png</Icon>
            <Icon Type="RollOver">./img/icon-r.png</Icon>
            <Icon Type="DarkNormal">./img/icon-n.png</Icon>
            <Icon Type="DarkRollOver">./img/icon-r.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
