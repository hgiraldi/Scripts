{
  "name": "alpha-faca",
  "productName": "Alpha Faca",
  "version": "0.1.0",
  "description": "Leitor de faca (DXF/PDF) e orçamento para o setor de facaria (uso interno Alpha)",
  "author": "Alpha Clicheria",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.alphaclicheria.alphafaca",
    "productName": "Alpha Faca",
    "directories": { "output": "dist" },
    "files": ["main.js", "src/**/*", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Alpha Faca"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.graphics-design"
    }
  }
}
